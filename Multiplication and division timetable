print("Multiplication and Division timetable")
def multiplication_table(n, max_factor=12):
    """Return a list of lines for the multiplication table of n."""
    lines = [f"Multiplication table of {n}", "-" * 30]
    for i in range(1, max_factor + 1):
        lines.append(f"{n} x {i:2} = {n * i}")
    return lines


def division_table(n, max_factor=12):
    """Return a list of lines for the division table of n."""
    lines = [f"Division table of {n}", "-" * 30]
    for i in range(1, max_factor + 1):
        product = n * i
        lines.append(f"{product} / {n} = {i}")
    return lines


def generate_timetable(start=1, end=12, max_factor=12):
    """Generate multiplication and division tables for a range of numbers."""
    output = []
    for n in range(start, end + 1):
        output.extend(multiplication_table(n, max_factor))
        output.append("")
        output.extend(division_table(n, max_factor))
        output.append("")
        output.append("=" * 30)
        output.append("")
    return "\n".join(output)


def main():
    print("=== Multiplication and Division Timetable Generator ===")
    try:
        start = int(input("Start number (default 1): ") or 1)
        end = int(input("End number (default 12): ") or 12)
        max_factor = int(input("Multiply up to (default 12): ") or 12)
    except ValueError:
        print("Please enter whole numbers only.")
        return

    if start > end:
        print("Start number must be less than or equal to the end number.")
        return

    timetable = generate_timetable(start, end, max_factor)
    print("\n" + timetable)

    save = input("Save to file? (y/n): ").strip().lower()
    if save == "y":
        filename = input("File name (default timetable.txt): ").strip() or "timetable.txt"
        with open(filename, "w", encoding="utf-8") as f:
            f.write(timetable)
        print(f"Timetable saved to {filename}")


if __name__ == "__main__":
    main()
